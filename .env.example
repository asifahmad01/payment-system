# -----------------------------------------------------------------------------
# Payment Processing API — environment template
# Copy to `.env` for local development:  cp .env.example .env
# Docker Compose injects equivalent values for the `api` service (see docker-compose.yml).
# -----------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL (required). Example matches docker-compose `postgres` service.
DATABASE_URL=postgresql://payment:payment@localhost:5432/payment?schema=public

# -----------------------------------------------------------------------------
# Redis — required when PAYMENT_RETRY_ENABLED=true (BullMQ delayed retries / deduped jobs)
# -----------------------------------------------------------------------------
# PAYMENT_RETRY_ENABLED=true
# REDIS_URL=redis://localhost:6379

PAYMENT_RETRY_ENABLED=false

PAYMENT_RETRY_BASE_DELAY_MS=5000
PAYMENT_RETRY_MAX_DELAY_MS=900000
PAYMENT_RETRY_EXPONENT_CAP=10

# -----------------------------------------------------------------------------
# Fake external gateway — probabilistic simulator used by the default PSP stub
# -----------------------------------------------------------------------------
PAYMENT_GATEWAY_SIM_SUCCESS_PROB=0.85
PAYMENT_GATEWAY_SIM_FAILURE_PROB=0.10
PAYMENT_GATEWAY_SIM_TIMEOUT_PROB=0.05
PAYMENT_GATEWAY_SIM_DELAY_MIN_MS=500
PAYMENT_GATEWAY_SIM_DELAY_MAX_MS=3000

# -----------------------------------------------------------------------------
# Stale “Processing” recovery — periodic sweep for expired processor leases
# -----------------------------------------------------------------------------
PAYMENT_RECOVERY_ENABLED=false
PAYMENT_RECOVERY_INTERVAL_MS=60000
PAYMENT_RECOVERY_MIN_IDLE_AFTER_LEASE_MS=0
PAYMENT_RECOVERY_BATCH_SIZE=50
